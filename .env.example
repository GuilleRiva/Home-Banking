# ==================================================
# MySQL
# ==================================================

MYSQL_DATABASE=banking
MYSQL_ROOT_PASSWORD=replace_with_a_secure_root_password

# Application database user
MYSQL_APP_USER=homebanking_app
MYSQL_APP_PASSWORD=replace_with_a_secure_app_password


# ==================================================
# Spring datasource - local / IntelliJ
# ==================================================
# Used when running Spring Boot from the host while
# MySQL is running through Docker Compose.

DB_URL=jdbc:mysql://localhost:3308/banking?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=homebanking_app

# Must match MYSQL_APP_PASSWORD above.
DB_PASSWORD=replace_with_a_secure_app_password


# ==================================================
# JWT
# ==================================================
# Generate your own long random secret.
# Never commit the real secret.

JWT_SECRET=replace_with_a_long_randomly_generated_secret

# 15 minutes
JWT_EXPIRATION=900000

# 15 days
JWT_REFRESH_EXPIRATION=1296000000